pipeline {
    agent any

    environment {
        // JMeter configuration
        JMETER_HOME = 'C:\\Program Files\\apache-jmeter-5.6.3'  // Adjust to your JMeter installation path
        JMETER_TEST = 'jmeter-tests/pipeline-test.jmx'
        JMETER_RESULTS = 'jmeter-results'
        APP_URL = 'http://localhost:8085'
    }

    stages {
        stage('Build') {
            steps {
                dir('PSW_Pipeline_Base') {
                    echo 'Building project with Maven'
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('PSW_Pipeline_Base') {
                    echo 'Running unit tests'
                    bat 'mvn test'
                }
            }
            post {
                always {
                    dir('PSW_Pipeline_Base') {
                        jacoco execPattern: 'target/jacoco.exec'
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('PSW_Pipeline_Base') {
                    echo 'Running SonarQube analysis'
                    withSonarQubeEnv('SonarQube') {
                        bat 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Start Application') {
            steps {
                dir('PSW_Pipeline_Base') {
                    echo 'Starting Spring Boot application'
                    script {
                        // Start application in background
                        bat 'start cmd /c mvn spring-boot:run'
                        // Wait for application to start
                        sleep(time: 30, unit: 'SECONDS')
                    }
                }
            }
        }

        stage('JMeter Tests') {
            steps {
                echo 'Running JMeter load tests'
                script {
                    bat "\"${env.JMETER_HOME}\\bin\\jmeter.bat\" -n -t PSW_Pipeline_Base/jmeter-tests/pipeline-test.jmx -l PSW_Pipeline_Base/jmeter-results/results.jtl -e -o PSW_Pipeline_Base/jmeter-results/report"
                }
            }
        }

        stage('Stop Application') {
            steps {
                echo 'Stopping Spring Boot application'
                bat 'taskkill /F /FI "WINDOWTITLE eq mvn spring-boot:run*"'
            }
        }
    }

    post {
        success {
            echo 'Pipeline successful'
            // Slack plugin not installed, using email instead
            emailext(
                subject: "✅ Pipeline SUCCESS: ${env.JOB_NAME} - Build #${env.BUILD_NUMBER}",
                body: "Pipeline completed successfully.\n\nSonarQube: PASSED\nJMeter: PASSED",
                to: 'admin@example.com'
            )
        }

        failure {
            echo 'Pipeline failed'
            emailext(
                subject: "❌ Pipeline FAILED: ${env.JOB_NAME} - Build #${env.BUILD_NUMBER}",
                body: "Pipeline failed. Check Jenkins console for details.",
                to: 'admin@example.com'
            )
        }

        always {
            echo 'Cleaning up workspace'
            cleanWs()
        }
    }
}
